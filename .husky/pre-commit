#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run lint-staged (ESLint + Prettier on staged JS/TS files).
# Any lint error exits non-zero and blocks the commit locally.
npx lint-staged

# Check Rust files in contracts/
RUST_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep "^contracts/.*\.rs$" || true)
if [ -n "$RUST_FILES" ]; then
  echo "Checking Rust formatting and linting..."
  cargo fmt --all -- --check
  cargo clippy --all-targets --all-features -- -D warnings
fi