{
  "name": "@brain-storm/sdk",
  "version": "1.0.0",
  "description": "TypeScript client SDK for Brain-Storm API (auto-generated from OpenAPI spec)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage --coverageThreshold='{\"global\":{\"lines\":85}}'",
    "test:signing": "jest --testPathPattern=transaction-signing",
    "test:signing:coverage": "jest --testPathPattern=transaction-signing --coverage --collectCoverageFrom=src/transaction-signing.ts --coverageThreshold='{\"src/transaction-signing.ts\":{\"lines\":90,\"statements\":90,\"functions\":90,\"branches\":90}}'",
    "generate": "node ../../scripts/generate-sdk.js",
    "docs": "node scripts/generate-docs.js",
    "docs:typedoc": "typedoc --out ../../docs/api/sdk src/index.ts",
    "audit": "npm audit --audit-level=high"
  },
  "peerDependencies": {
    "axios": ">=1.7.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.2"
  },
  "keywords": [
    "brain-storm",
    "sdk",
    "api",
    "stellar"
  ],
  "author": "Brain-Storm",
  "license": "MIT"
}
